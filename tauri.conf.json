{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fallen Earth Overlay",
  "version": "0.1.16",
  "identifier": "gg.primeval.overlay",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https:"
    },
    "windows": [
      {
        "label": "main",
        "title": "Fallen Earth Overlay",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
